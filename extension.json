{
	"name": "Beacon",
	"author": [
		"Telepedia Ltd."
	],
	"url": "https://github.com/telepedia/mediawiki-extensions-beacon",
	"descriptionmsg": "beacon-desc",
	"license-name": "GPL-3.0-or-later",
	"type": "other",
	"version": "0.0.0",
	"requires": {
		"MediaWiki": ">= 1.47.0",
		"platform": {
			"php": ">= 8.1"
		}
	},
	"MessagesDirs": {
		"Beacon": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"BeaconAlias": "Beacon.alias.php"
	},
	"SpecialPages": {
		"Notifications": {
			"class": "Telepedia\\Extensions\\Beacon\\Special\\SpecialNotifications",
			"services": [
				"Beacon.NotificationStore"
			]
		}
	},
	"AutoloadNamespaces": {
		"Telepedia\\Extensions\\Beacon\\": "includes/"
	},
	"ResourceModules": {
		"ext.beacon.styles": {
			"styles": [
				"badge.less"
			],
			"skinStyles": {
				"timeless": [
					"skins/timeless.less"
				]
			},
			"localBasePath": "resources/ext.beacon.styles",
			"remoteExtPath": "Beacon/resources/ext.beacon.styles"
		},
		"ext.beacon.list.styles": {
			"styles": [
				"icons.less",
				"item.less"
			],
			"localBasePath": "resources/ext.beacon.list.styles",
			"remoteExtPath": "Beacon/resources/ext.beacon.list.styles"
		},
		"ext.beacon.special.styles": {
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"codexStyleOnly": true,
			"codexComponents": [
				"CdxButton"
			],
			"styles": [
				"special.less"
			],
			"localBasePath": "resources/ext.beacon.special.styles",
			"remoteExtPath": "Beacon/resources/ext.beacon.special.styles"
		},
		"ext.beacon.special": {
			"packageFiles": [
				"special.js"
			],
			"dependencies": [
				"mediawiki.util",
				"user.options"
			],
			"messages": [
				"beacon-popover-mark-unread"
			],
			"localBasePath": "resources/ext.beacon.special",
			"remoteExtPath": "Beacon/resources/ext.beacon.special"
		},
		"ext.beacon.init": {
			"packageFiles": [
				"init.js"
			],
			"localBasePath": "resources/ext.beacon.init",
			"remoteExtPath": "Beacon/resources/ext.beacon.init"
		},
		"ext.beacon.popover": {
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"packageFiles": [
				"init.js",
				"notifications.js",
				"components/App.vue",
				"components/NotificationItem.vue",
				{
					"name": "config.json",
					"callback": "Telepedia\\Extensions\\Beacon\\ResourceLoader\\PopoverConfig::getConfig"
				},
				{
					"name": "icons.json",
					"callback": "MediaWiki\\ResourceLoader\\CodexModule::getIcons",
					"callbackParam": [
						"cdxIconCheckAll",
						"cdxIconHistory",
						"cdxIconSettings"
					]
				}
			],
			"dependencies": [
				"ext.beacon.list.styles",
				"vue",
				"pinia",
				"mediawiki.api",
				"mediawiki.language",
				"mediawiki.util",
				"mediawiki.DateFormatter"
			],
			"codexComponents": [
				"CdxButton",
				"CdxIcon",
				"CdxPopover"
			],
			"messages": [
				"beacon-popover-title",
				"beacon-popover-empty",
				"beacon-popover-mark-read",
				"beacon-popover-mark-unread",
				"beacon-popover-mark-all-read",
				"beacon-popover-error",
				"beacon-popover-retry",
				"beacon-popover-action-error",
				"beacon-popover-all",
				"beacon-popover-preferences",
				"beacon-notifications-badge",
				"beacon-badge-count-max"
			],
			"localBasePath": "resources/ext.beacon.popover",
			"remoteExtPath": "Beacon/resources/ext.beacon.popover"
		}
	},
	"DatabaseVirtualDomains": [
		"virtual-beacon"
	],
	"ConfigRegistry": {
		"Beacon": "MediaWiki\\Config\\GlobalVarConfig::newInstance"
	},
	"HookHandlers": {
		"schema": {
			"class": "Telepedia\\Extensions\\Beacon\\Hooks\\SchemaHooks"
		},
		"preferences": {
			"class": "Telepedia\\Extensions\\Beacon\\Hooks\\PreferencesHooks",
			"services": [
				"Beacon.NotificationCategoryRegistry"
			]
		},
		"skin": {
			"class": "Telepedia\\Extensions\\Beacon\\Hooks\\SkinHooks",
			"services": [
				"Beacon.NotificationStore"
			]
		}
	},
	"Hooks": {
		"GetPreferences": "preferences",
		"LoadExtensionSchemaUpdates": "schema",
		"OutputPageCheckLastModified": "skin",
		"SkinTemplateNavigation::Universal": "skin",
		"UserGetDefaultOptions": "preferences"
	},
	"ServiceWiringFiles": [
		"includes/ServiceWiring.php"
	],
	"DomainEventIngresses": [
		{
			"events": [
				"PageDeleted",
				"PageLatestRevisionChanged"
			],
			"class": "Telepedia\\Extensions\\Beacon\\Handlers\\PageVisibilityHandler",
			"services": [
				"JobQueueGroup"
			]
		},
		{
			"events": [
				"PageLatestRevisionChanged"
			],
			"class": "Telepedia\\Extensions\\Beacon\\Handlers\\RevertHandler",
			"services": [
				"RevisionStore",
				"TitleFactory",
				"CommentFormatter",
				"Beacon.NotificationSender"
			]
		},
		{
			"events": [
				"PageLatestRevisionChanged"
			],
			"class": "Telepedia\\Extensions\\Beacon\\Handlers\\UserJsEditHandler",
			"services": [
				"TitleFactory",
				"UserIdentityLookup",
				"UserIdentityUtils",
				"Beacon.NotificationSender"
			]
		}
	],
	"attributes": {
		"Beacon": {
			"Categories": {
				"edited-other-users-js": {
					"label": "beacon-category-edited-other-users-js"
				},
				"reverted": {
					"label": "beacon-category-reverted"
				}
			},
			"Icons": {},
			"PopoverPlacement": {},
			"Types": {
				"edited-other-users-js": {
					"category": "edited-other-users-js",
					"presenter": {
						"class": "Telepedia\\Extensions\\Beacon\\Presentation\\UserJsEditPresenter"
					}
				},
				"reverted": {
					"category": "reverted",
					"presenter": {
						"class": "Telepedia\\Extensions\\Beacon\\Presentation\\RevertedPresenter"
					}
				}
			}
		}
	},
	"RestRoutes": [
		{
			"path": "/beacon/v1/notifications",
			"method": [
				"GET"
			],
			"class": "Telepedia\\Extensions\\Beacon\\Rest\\GetNotificationHandler",
			"services": [
				"Beacon.NotificationStore",
				"UserIdentityUtils"
			]
		},
		{
			"path": "/beacon/v1/notifications/read",
			"method": [
				"POST"
			],
			"class": "Telepedia\\Extensions\\Beacon\\Rest\\DismissNotificationHandler",
			"services": [
				"Beacon.NotificationStore",
				"UserIdentityUtils"
			]
		},
		{
			"path": "/beacon/v1/notifications/read-all",
			"method": [
				"POST"
			],
			"class": "Telepedia\\Extensions\\Beacon\\Rest\\DismissAllHandler",
			"services": [
				"Beacon.NotificationStore",
				"UserIdentityUtils"
			]
		},
		{
			"path": "/beacon/v1/notifications/unread",
			"method": [
				"POST"
			],
			"class": "Telepedia\\Extensions\\Beacon\\Rest\\MarkUnreadHandler",
			"services": [
				"Beacon.NotificationStore",
				"UserIdentityUtils"
			]
		}
	],
	"JobClasses": {
		"BeaconHidePageNotificationsJob": {
			"class": "Telepedia\\Extensions\\Beacon\\Jobs\\BeaconHidePageNotificationsJob",
			"needsPage": false,
			"services": [
				"Beacon.NotificationStore",
				"ConnectionProvider"
			]
		}
	},
	"manifest_version": 2
}
